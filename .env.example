# ---------------------------------------------------------------------------
# StudyFlow AI — environment template
# Copy to backend/.env for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- server ---
NODE_ENV=development
PORT=5001
HOST=127.0.0.1
TRUST_PROXY=false

# --- database ---
# Local:  mongodb://127.0.0.1:27017/studyflow
# Atlas:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/studyflow?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/studyflow

# --- auth (REQUIRED in production; generate with `openssl rand -hex 48`) ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# --- browser origins allowed to call the API (only needed when the UI is on
#     a different origin; the Docker image serves both from one origin) ---
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- public URL used in password reset links ---
PUBLIC_URL=http://127.0.0.1:5173

# --- uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# --- optional AI provider (any OpenAI-compatible endpoint) ---
# Leave unset to run without AI; the assistant then labels its answers as
# built-in frameworks instead of model output.
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
