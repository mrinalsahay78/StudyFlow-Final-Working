# ---------------------------------------------------------------------------
# StudyFlow backend environment
# Copy to backend/.env and fill in your own values. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5001
HOST=127.0.0.1

# MongoDB connection string. Local install, Docker, or Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/studyflow

# REQUIRED in production. Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Browser origins allowed to call the API (comma separated).
# Not needed in production when this server also serves the built frontend.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Public URL of the app, used in password reset links.
PUBLIC_URL=http://127.0.0.1:5173

# Uploads (notes library). Directory must be writable.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Serve the built frontend from this directory (defaults to ../frontend/dist)
# CLIENT_DIR=../frontend/dist

# Set to true when running behind a reverse proxy (Render, Railway, nginx...)
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# AI study assistant (optional). Any OpenAI-compatible chat-completions API.
# Leave AI_PROVIDER empty to run without AI: the assistant still works but
# clearly labels its answers as built-in frameworks, not model output.
# ---------------------------------------------------------------------------
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-key-here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=60000

# Examples for other providers:
# Groq:      AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
# OpenRouter:AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=openai/gpt-4o-mini
# Ollama:    AI_PROVIDER=ollama AI_API_KEY=ollama AI_BASE_URL=http://127.0.0.1:11434/v1 AI_MODEL=llama3.1
